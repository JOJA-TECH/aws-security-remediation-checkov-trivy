# Example environment file for local tooling.
# Copy to .env (ignored by git) and fill in real values. NEVER commit secrets.

# AWS
AWS_REGION=us-east-1
AWS_PROFILE=remediation

# Terraform backend (outputs from `bootstrap/`)
TF_STATE_BUCKET=aws-security-remediation-checkov-trivy-tfstate-000000000000
TF_LOCK_TABLE=aws-security-remediation-checkov-trivy-tflock

# Project naming (must match terraform/secure variables)
PROJECT=secure-demo
ENVIRONMENT=dev

# GitHub Actions (configured in the repo, not here):
#   secret   AWS_ROLE_ARN
#   var      AWS_REGION, TF_STATE_BUCKET, TF_LOCK_TABLE
